# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://cinema_user:cinema_local_password@localhost:5433/online_cinema

# JWT Authentication
JWT_SECRET_KEY=replace_with_your_own_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Email / SMTP (MailHog)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@online-cinema.local

# Application URL
BASE_URL=http://127.0.0.1:8000